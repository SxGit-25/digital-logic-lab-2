set_location_assignment PIN_38 -to matrix_col_g[7]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *

set_global_assignment -name LAST_QUARTUS_VERSION 9.1
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# MAX II board manual page 7, section 9: SW6 is device pin 127.
set_location_assignment PIN_127 -to sw6
set_location_assignment PIN_32 -to lcd_rd_n
set_location_assignment PIN_37 -to lcd_wr_n
set_location_assignment PIN_48 -to lcd_a0
