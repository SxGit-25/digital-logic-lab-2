set_location_assignment PIN_12 -to matrix_col_r[6]
set_location_assignment PIN_11 -to matrix_col_r[7]

set_location_assignment PIN_45 -to matrix_col_g[0]
set_location_assignment PIN_44 -to matrix_col_g[1]
set_location_assignment PIN_43 -to matrix_col_g[2]
