set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_cs_n
set_location_assignment PIN_102 -to lcd_data[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_data[2]
