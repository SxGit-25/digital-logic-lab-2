set_instance_assignment -name VIRTUAL_PIN ON -to direction_up
set_instance_assignment -name VIRTUAL_PIN ON -to radius_valid
set_instance_assignment -name VIRTUAL_PIN ON -to angle_bcd[*]
set_instance_assignment -name VIRTUAL_PIN ON -to radius[*]
set_instance_assignment -name VIRTUAL_PIN ON -to ready
set_instance_assignment -name VIRTUAL_PIN ON -to done
set_instance_assignment -name VIRTUAL_PIN ON -to dropped[*]
set_location_assignment PIN_32 -to lcd_rd_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_rd_n
set_location_assignment PIN_107 -to lcd_data[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to lcd_data[7]
