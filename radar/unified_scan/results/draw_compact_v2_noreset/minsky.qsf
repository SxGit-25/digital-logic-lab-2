set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM1270T144C5
set_global_assignment -name TOP_LEVEL_ENTITY minsky_lcd_compact_v2_test_top
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE OFF
set_global_assignment -name USE_TIMEQUEST_TIMING_ANALYZER ON
set_global_assignment -name MAXII_OPTIMIZATION_TECHNIQUE AREA
set_global_assignment -name AUTO_RESOURCE_SHARING ON
set_global_assignment -name MUX_RESTRUCTURE ON
set_location_assignment PIN_18 -to clk
set_global_assignment -name VERILOG_FILE lcd_bus.v
set_global_assignment -name VERILOG_FILE lcd_init.v
set_global_assignment -name VERILOG_FILE minsky_lcd_compact_v2_test_top.v
