set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM1270T144C5
set_global_assignment -name TOP_LEVEL_ENTITY lcd_p1_write_top
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE OFF
set_global_assignment -name USE_TIMEQUEST_TIMING_ANALYZER ON
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE lcd_p1_write.sdc
set_global_assignment -name VERILOG_FILE lcd_p1_top.v
set_global_assignment -name VERILOG_FILE ../rtl/reset_ctrl.v
set_global_assignment -name VERILOG_FILE ../rtl/lcd_bus.v
set_global_assignment -name VERILOG_FILE ../rtl/lcd_init.v
set_global_assignment -name VERILOG_FILE ../rtl/lcd_p1_pattern.v
set_global_assignment -name VERILOG_FILE ../rtl/lcd_p1_core.v
set_location_assignment PIN_18 -to clk
set_location_assignment PIN_32 -to lcd_rd_n
set_location_assignment PIN_37 -to lcd_wr_n
set_location_assignment PIN_48 -to lcd_a0
set_location_assignment PIN_109 -to lcd_rst_n
set_location_assignment PIN_108 -to lcd_cs_n
set_location_assignment PIN_101 -to lcd_data[0]
set_location_assignment PIN_110 -to lcd_data[1]
set_location_assignment PIN_102 -to lcd_data[2]
set_location_assignment PIN_103 -to lcd_data[3]
set_location_assignment PIN_104 -to lcd_data[4]
set_location_assignment PIN_105 -to lcd_data[5]
set_location_assignment PIN_106 -to lcd_data[6]
set_location_assignment PIN_107 -to lcd_data[7]
set_location_assignment PIN_80 -to led[0]
set_location_assignment PIN_79 -to led[1]
set_location_assignment PIN_78 -to led[2]
set_location_assignment PIN_77 -to led[3]
set_location_assignment PIN_76 -to led[4]
set_location_assignment PIN_75 -to led[5]
set_location_assignment PIN_74 -to led[6]
set_location_assignment PIN_73 -to led[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *

set_global_assignment -name LAST_QUARTUS_VERSION 9.1
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"