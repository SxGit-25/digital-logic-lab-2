set_global_assignment -name VERILOG_FILE ../rtl/seg_scan.v
set_global_assignment -name VERILOG_FILE ../rtl/matrix_scan.v
set_global_assignment -name VERILOG_FILE ../rtl/alarm_ctrl.v
set_global_assignment -name VERILOG_FILE ../rtl/radar_top.v

