set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM1270T144C5
set_global_assignment -name TOP_LEVEL_ENTITY radar_top
set_global_assignment -name POWER_UP_DONT_CARE OFF
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE radar.sdc

set_global_assignment -name VERILOG_FILE ../rtl/reset_ctrl.v
set_global_assignment -name VERILOG_FILE ../rtl/timebase.v
set_global_assignment -name VERILOG_FILE ../rtl/switch_filter.v
